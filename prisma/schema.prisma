// Digi∞Artha — Prisma schema
// Lead capture + Growth Score reports.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../db/custom.db"
}

model Lead {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  company   String?
  website   String?
  industry  String?
  topic     String? // "What do you need help with?"
  message   String?
  source    String? @default("website-contact")
  utm       String? // raw utm string captured client-side
  status    String  @default("new") // new | qualified | contacted | won | lost
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GrowthScoreReport {
  id         String   @id @default(cuid())
  url        String
  overall    Int
  dimensions String   // JSON-stringified array of { dimension, score, status, opportunities }
  summary    String?
  ip         String?
  createdAt  DateTime @default(now())
}
