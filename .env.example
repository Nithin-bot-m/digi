# Digi∞Artha Environment Variables
# Copy this file to .env.local for local development.
# On Vercel: Add these under Project Settings > Environment Variables.

# Resend API Key for sending lead notifications (get from resend.com/api-keys)
RESEND_API_KEY=re_your_api_key_here

# Recipient email where all leads and inquiries are delivered
LEAD_RECIPIENT_EMAIL=sudhanva@isdinfosolutions.com

# Sender email address
# For testing: "Digi∞Artha Leads <onboarding@resend.dev>"
# For production (after verifying your custom domain in Resend): "Digi∞Artha Leads <hello@yourdomain.com>"
RESEND_FROM_EMAIL=Digi∞Artha Leads <onboarding@resend.dev>

# Optional Cloudflare Turnstile anti-spam keys
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
